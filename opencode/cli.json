{
  "$schema": "https://opencode.ai/v2/cli.json",
  "theme": {
    "name": "synthwave84",
    "mode": "light"
  },
  "tabs": {
    "mode": "off",
    "layout": "horizontal",
    "indicators": "numbers"
  },
  "animations": false,
  "session": {
    "image_preview": false,
    "markdown": "rendered",
    "verbosity": "low"
  },
  "prompt": {
    "image_preview": true
  },
  "plugins": [
    "./herdr-opencode"
  ],
  "diffs": {
    "single": false,
    "view": "auto",
    "tree": true,
    "wrap": "word"
  }
}
