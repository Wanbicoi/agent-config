{
  "$schema": "https://opencode.ai/v2/cli.json",
  "theme": {
    "name": "synthwave84",
    "mode": "light"
  },
  "tabs": {
    "mode": "off",
    "layout": "horizontal",
    "indicators": "numbers"
  },
  "animations": false,
  "session": {
    "image_preview": false,
    "markdown": "rendered",
    "verbosity": "low",
    "sidebar": "hide"
  },
  "prompt": {
    "image_preview": true
  },
  "plugins": [
    "./herdr-opencode"
  ],
  "keybinds": {
    "input.buffer.home": "home",
    "input.buffer.end": "end",
    "session.first": "ctrl+g,ctrl+home,alt+home",
    "session.last": "ctrl+alt+g,ctrl+end"
  },
  "diffs": {
    "single": false,
    "view": "auto",
    "tree": true,
    "wrap": "word"
  }
}
